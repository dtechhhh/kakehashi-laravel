APP_NAME=Kakehashi
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kakehashi
DB_USERNAME=kakehashi
DB_PASSWORD=

# Runtime only (PHP-FPM / queue / default connection). Never put migrator secrets here.
# Migrator CLI credentials: use process env or a local .env.migrator (mode 600, gitignored):
#   DB_MIGRATOR_USERNAME=kakehashi_migrator
#   DB_MIGRATOR_PASSWORD=
# Local:  set -a && source .env.migrator && set +a
#         php artisan migrate:fresh --database=pgsql_migrator --force
# CI: inject DB_MIGRATOR_USERNAME / DB_MIGRATOR_PASSWORD into the job env only.
# Production FPM/queue must not receive DB_MIGRATOR_*.

# PHPUnit uses a separate database (see phpunit.xml): kakehashi_test
# Create both databases and enable pg_trgm before migrate / test.
# Copy this file to .env and fill secrets locally — never commit .env.

# Local/dev: Redis for cache, session, queue, and rate-limit (PRD / DEPLOYMENT).
# Production session lifetime is 30 minutes. Redis is not business source of truth.
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Atomic same-session requests (step-up single-use): Redis lock for full request.
SESSION_BLOCK=true
SESSION_BLOCK_STORE=redis
SESSION_BLOCK_LOCK_SECONDS=30
SESSION_BLOCK_WAIT_SECONDS=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis must bind localhost only; maxmemory-policy noeviction on the server.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# R2 / S3-compatible — leave empty in template; set only in local/server .env
# Candidate photos only (private). Documents stay Google Drive URL input.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional R2-specific overrides (fallback to AWS_* above)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true
# local | s3 — use local for tests/dev without credentials
R2_DISK_DRIVER=s3

VITE_APP_NAME="${APP_NAME}"
